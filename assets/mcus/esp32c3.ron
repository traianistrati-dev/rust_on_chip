McuDefinition(
    id: "esp32c3",
    display_name: "ESP32-C3",
    family: "esp32c3",
    package: "QFN32",
    dma: Some(DmaDef(
        mux: true,
        channels: [
            DmaChannel(
                peri: "DMA_CH0",
                irq: "",
            ),
            DmaChannel(
                peri: "DMA_CH1",
                irq: "",
            ),
            DmaChannel(
                peri: "DMA_CH2",
                irq: "",
            ),
        ],
    )),
    max_mhz: Some(160),
    sram_kb: Some(384),
    cpu: "RISC-V 32-bit",
    toolchain: EspRust,
    project: ProjectDef(
        pkg_name: "esp32c3",
        target: "riscv32imc-unknown-none-elf",
        flash_origin: "",
        flash_size: "",
        ram_origin: "",
        ram_size: "",
        hal_dep: "esp-hal = { version = \"0.23\", features = [\"esp32c3\", \"unstable\"] }",
        probe_chip: "esp32c3",
        memory_comment: "",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 32,
                name: "VDDA",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 31,
                name: "VDDA",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 30,
                name: "XTAL_P",
                reserved: true,
                functions: [],
                note: "Fit a 40 MHz crystal: Espressif says the C3 firmware supports no other frequency (ESP-IDF offers only 40 MHz), and esp-hal 1.1 always configures the C3 for 40 MHz. Espressif asks for a crystal accurate to +-10 ppm.",
            ),
            PinDef(
                number: 29,
                name: "XTAL_N",
                reserved: true,
                functions: [],
                note: "Fit a 40 MHz crystal: Espressif says the C3 firmware supports no other frequency (ESP-IDF offers only 40 MHz), and esp-hal 1.1 always configures the C3 for 40 MHz. Espressif asks for a crystal accurate to +-10 ppm.",
            ),
            PinDef(
                number: 28,
                name: "GPIO21",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 4,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 5,
                    ),
                    UsartTx(1),
                    UsartRx(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                    RmtChannel(0),
                    RmtChannel(1),
                    RmtChannel(2),
                    RmtChannel(3),
                    I2sCk(0),
                    I2sWs(0),
                    I2sSd(0),
                    I2sMck(0),
                    CanTx,
                    CanRx,
                ],
                note: "U0TXD: the ROM prints its boot log here at every boot by default (eFuse UART_PRINT_CONTROL can make it follow GPIO8 or switch it off) and answers UART download mode here. It is an enabled output after reset, so never tie it to another driver. Espressif suggests a 499 ohm series resistor against harmonics.",
            ),
            PinDef(
                number: 27,
                name: "GPIO20",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartRx(0),
                    UsartTx(0),
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 4,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 5,
                    ),
                    UsartTx(1),
                    UsartRx(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                    RmtChannel(0),
                    RmtChannel(1),
                    RmtChannel(2),
                    RmtChannel(3),
                    I2sCk(0),
                    I2sWs(0),
                    I2sSd(0),
                    I2sMck(0),
                    CanTx,
                    CanRx,
                ],
                note: "U0RXD: UART0 RX by default and the receive line of the ROM\'s UART download mode (GPIO9 low and GPIO8 high at reset). Weak pull-up enabled after reset.",
            ),
            PinDef(
                number: 26,
                name: "GPIO19",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsbDp,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 4,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 5,
                    ),
                    UsartTx(0),
                    UsartRx(0),
                    UsartTx(1),
                    UsartRx(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                    RmtChannel(0),
                    RmtChannel(1),
                    RmtChannel(2),
                    RmtChannel(3),
                    I2sCk(0),
                    I2sWs(0),
                    I2sSd(0),
                    I2sMck(0),
                    CanTx,
                    CanRx,
                ],
                note: "USB D+ (USB Serial/JTAG), pulled up from reset; Espressif warns it swings high and low at power-up and advises an external pull-up for a steady level. esp-hal clears the USB pads and pull-ups once GPIO18/19 serve as GPIO or another peripheral, so the USB log/download/JTAG port is gone while firmware runs; reflash with GPIO9 low, GPIO8 high at reset.",
            ),
            PinDef(
                number: 25,
                name: "GPIO18",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsbDm,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 4,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 5,
                    ),
                    UsartTx(0),
                    UsartRx(0),
                    UsartTx(1),
                    UsartRx(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                    RmtChannel(0),
                    RmtChannel(1),
                    RmtChannel(2),
                    RmtChannel(3),
                    I2sCk(0),
                    I2sWs(0),
                    I2sSd(0),
                    I2sMck(0),
                    CanTx,
                    CanRx,
                ],
                note: "USB D- of the USB Serial/JTAG, which by default carries the ROM log, download mode and JTAG. esp-hal switches the USB pads off once GPIO18 or GPIO19 is used as GPIO or by any other peripheral, so the host loses that port while your firmware runs; reflash with GPIO9 low and GPIO8 high through reset. Drives high for about 50 us at power-up.",
            ),
        ],
