McuDefinition(
    id: "esp32c61",
    display_name: "ESP32-C61",
    family: "esp32c61",
    package: "QFN40",
    max_mhz: Some(160),
    sram_kb: Some(320),
    dma: Some(DmaDef(
        mux: true,
        channels: [
            DmaChannel(
                peri: "DMA_CH0",
                irq: "",
            ),
            DmaChannel(
                peri: "DMA_CH1",
                irq: "",
            ),
        ],
    )),
    cpu: "RISC-V 32-bit",
    toolchain: EspRust,
    project: ProjectDef(
        pkg_name: "esp32c61",
        target: "riscv32imac-unknown-none-elf",
        flash_origin: "",
        flash_size: "",
        ram_origin: "",
        ram_size: "",
        hal_dep: "",
        probe_chip: "esp32c61",
        memory_comment: "",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 40,
                name: "VDDA2",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 39,
                name: "XTAL_P",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 38,
                name: "XTAL_N",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 37,
                name: "VDDA1",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 36,
                name: "GPIO7",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
                    UsartCts(1),
                    UsartRts(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                ],
                note: "Strapping pin for the JTAG source, but it only counts if EFUSE_JTAG_SEL_ENABLE is burned and EFUSE_DIS_PAD_JTAG/DIS_USB_JTAG are not (all 0 by default). It floats at reset (no internal pull), so in that case an external circuit must drive it: high keeps JTAG on USB Serial/JTAG, low moves it to the MTMS/MTDI/MTCK/MTDO pads (GPIO3-6).",
            ),
            PinDef(
                number: 35,
                name: "GPIO29",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
                    UsartCts(1),
                    UsartRts(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                ],
            ),
            PinDef(
                number: 34,
                name: "GPIO11",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
                    UsartCts(1),
                    UsartRts(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                ],
                note: "U0TXD, UART0 TX by default. UART0 is the ROM\'s port for UART download and for its boot log, printed at every reset by default, so whatever is wired here sees that traffic. Espressif suggests a 499 ohm series resistor on this line.",
            ),
            PinDef(
                number: 33,
                name: "GPIO10",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
                    UsartCts(1),
                    UsartRts(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                ],
                note: "U0RXD, UART0 RX by default (weak pull-up after reset): the line the ROM listens on for UART download (UART0 is its download and boot-log port).",
            ),
            PinDef(
                number: 32,
                name: "GPIO9",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
                    UsartCts(1),
                    UsartRts(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                ],
                note: "Boot-mode strapping pin with a weak pull-up: held LOW at reset while GPIO8 is HIGH, the chip enters Joint Download Boot (UART0, USB or SDIO) instead of booting from flash. Espressif recommends an external pull-up and no high-value capacitor on it, or the chip may enter download mode.",
            ),
            PinDef(
                number: 31,
                name: "GPIO8",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
                    UsartCts(1),
                    UsartRts(1),
                    SpiSck(2),
                    SpiMosi(2),
                    SpiMiso(2),
                    SpiNss(2),
                    I2cScl(0),
                    I2cSda(0),
                ],
                note: "Strapping pin, floating by default. Download mode (GPIO9 low at reset) needs GPIO8 HIGH; GPIO8 and GPIO9 both low is an invalid combination. If eFuse UART_PRINT_CONTROL is set to 1 or 2, GPIO8\'s level at reset also turns the ROM boot log on UART0 on or off (1: printed when low, 2: printed when high).",
            ),
        ],
