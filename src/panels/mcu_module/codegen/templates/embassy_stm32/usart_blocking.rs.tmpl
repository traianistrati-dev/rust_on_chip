/// embassy's blocking `Uart`, with the `embedded-io` `Read` it has no impl
/// of: its own `blocking_read` fills the whole slice it is given, so a read
/// asks for one byte - more would wait for bytes that may never come.
pub struct SerialIo<'d>(pub Uart<'d, Blocking>);

impl embedded_io::ErrorType for SerialIo<'_> {
    type Error = embassy_stm32::usart::Error;
}

impl embedded_io::Read for SerialIo<'_> {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize, Self::Error> {
        if buf.is_empty() {
            return Ok(0);
        }
        self.0.blocking_read(&mut buf[..1])?;
        Ok(1)
    }
}

impl embedded_io::Write for SerialIo<'_> {
    fn write(&mut self, buf: &[u8]) -> Result<usize, Self::Error> {
        self.0.blocking_write(buf)?;
        Ok(buf.len())
    }

    fn flush(&mut self) -> Result<(), Self::Error> {
        self.0.blocking_flush()
    }
}

