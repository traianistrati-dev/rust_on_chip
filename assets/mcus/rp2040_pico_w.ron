McuDefinition(
    id: "rp2040_pico_w",
    display_name: "Raspberry Pi Pico W",
    family: "rp2040",
    package: "40-pin header",
    board_chip: Some("RP2040"),
    max_mhz: Some(133),
    cpu: "ARM Cortex-M0+ (dual)",
    toolchain: RustEmbedded,
    project: ProjectDef(
        pkg_name: "rp2040_pico_w",
        target: "thumbv6m-none-eabi",
        flash_origin: "0x10000000",
        flash_size: "2048K",
        ram_origin: "0x20000000",
        ram_size: "264K",
        hal_dep: "rp2040-hal = { version = \"0.12\", features = [\"rt\", \"critical-section-impl\"] }",
        hal_dep_async: Some("embassy-rp = { version = \"0.10\", features = [\"rp2040\", \"critical-section-impl\", \"time-driver\"] }"),
        probe_chip: "RP2040",
        memory_comment: "Raspberry Pi Pico W (RP2040)  (Pico W: GP23-25 and GP29 belong to the CYW43 radio)",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 41,
                name: "WL_ON",
                reserved: true,
                functions: [],
                note: "Drives both WL_REG_ON and BT_REG_ON of the CYW43439, so Wi-Fi and Bluetooth power up together. The cyw43 driver holds it low 20 ms, then high, and waits 250 ms before its first SPI access - start-up time that any radio use, even the LED, adds.",
            ),
            PinDef(
                number: 42,
                name: "WL_D",
                reserved: true,
                functions: [],
                note: "Also the radio\'s IRQ. On the CYW43439 it joins SDIO_CMD (gSPI data in), SDIO_DATA0 (data out) via R87 470R, SDIO_DATA1 (IRQ) via R88 10k, and SDIO_DATA2 directly - a strap sampled at power-up that selects gSPI when low, so GP24 must be low while WL_ON brings the radio up. IRQs can only be checked between SPI transactions.",
            ),
            PinDef(
                number: 43,
                name: "WL_CS",
                reserved: true,
                functions: [],
                note: "HIGH also turns on FET Q1 (DMG1012T), which connects VSYS through R5 (20k) to GP29, where R6 (10k) goes to GND - this is how VSYS/3 reaches ADC3. The radio drivers keep CS high whenever no transaction is running.",
            ),
            PinDef(
                number: 44,
                name: "WL_CLK",
                reserved: true,
                functions: [],
                note: "R6 (10k) to GND loads this line. VSYS/3 (ADC3) is readable only between radio transactions, with GP25 high and GP29 moved from the PIO to the ADC: pico_w.h says to wrap the read in cyw43_thread_enter/exit, and pico-sdk\'s driver re-selects the PIO at the next transaction. cyw43-pio 0.10\'s PioSpi has no call that lends GP29 out.",
            ),
            PinDef(
                number: 45,
                name: "WL_LED",
                reserved: false,
                functions: [
                    GpioOutput,
                ],
                note: "Green LED D2 on the radio\'s WL_GPIO0, through R3 (470R) to GND. Only the CYW43439 can drive it: cyw43 first power-cycles the radio and downloads its ~226 KiB firmware (43439A0.bin, kept in flash), then each Control::gpio_set(0, on) is a command over the radio\'s SPI. Test point TP5 only swings up to the LED\'s forward voltage.",
            ),
        ],
        left: [
            PinDef(
                number: 1,
                name: "GP0",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(0),
                    UsartTx(0),
                    I2cSda(0),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                ],
                note: "GP pins are RP2040 GPIO, 3.3 V only - the absolute maximum on any of them is IOVDD + 0.5 V, so none is 5 V tolerant. All GPIO and QSPI pins together may source at most 50 mA and sink at most 50 mA.",
            ),
            PinDef(
                number: 2,
                name: "GP1",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiNss(0),
                    UsartRx(0),
                    I2cScl(0),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                ],
                note: "GP pins are RP2040 GPIO, 3.3 V only - the absolute maximum on any of them is IOVDD + 0.5 V, so none is 5 V tolerant. All GPIO and QSPI pins together may source at most 50 mA and sink at most 50 mA.",
            ),
            PinDef(
                number: 3,
                name: "GND",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 4,
                name: "GP2",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(0),
                    UsartCts(0),
                    I2cSda(1),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                ],
                note: "GP pins are RP2040 GPIO, 3.3 V only - the absolute maximum on any of them is IOVDD + 0.5 V, so none is 5 V tolerant. All GPIO and QSPI pins together may source at most 50 mA and sink at most 50 mA.",
            ),
            PinDef(
                number: 5,
                name: "GP3",
                reserved: false,
                functions: [
