McuDefinition(
    id: "nrf54l15_dk",
    display_name: "Nordic nRF54L15 DK",
    family: "nrf54l15",
    package: "DK headers",
    board_chip: Some("nRF54L15"),
    max_mhz: Some(64),
    sram_kb: Some(256),
    dma: None,
    cpu: "ARM Cortex-M33",
    toolchain: RustEmbedded,
    project: ProjectDef(
        pkg_name: "nrf54l15_dk",
        target: "thumbv8m.main-none-eabihf",
        flash_origin: "0x00000000",
        flash_size: "1524K",
        ram_origin: "0x20000000",
        ram_size: "256K",
        hal_dep: "embassy-nrf = { version = \"0.11\", features = [\"nrf54l15-app-s\"] }",
        hal_dep_async: Some("embassy-nrf = { version = \"0.11\", features = [\"nrf54l15-app-s\", \"time-driver-grtc\", \"gpiote\", \"nfc-pins-as-gpio\"] }"),
        probe_chip: "nRF54L15_xxAA",
        memory_comment: "Nordic nRF54L15 DK (nRF54L15)  -  1524 KiB Flash / 256 KiB RAM",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 16,
                name: "P2.09 (LED0, active HIGH)",
                reserved: false,
                functions: [
                    GpioOutput,
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator. Switches LED0 through a transistor (LEDs powered by the PMIC, dark if \'Power to LEDs\' is off). Also trace port TRACEDATA[2].",
            ),
            PinDef(
                number: 17,
                name: "P1.10 (LED1, active HIGH)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 20,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 20,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 20,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 20,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 21,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 21,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 21,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 21,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 22,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 22,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 22,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 22,
                        channel: 3,
                    ),
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator. Switches LED1 through a transistor; the LEDs are powered by the PMIC and stay dark if \'Power to LEDs\' is off in Board Configurator.",
            ),
            PinDef(
                number: 18,
                name: "P2.07 (LED2, active HIGH)",
                reserved: false,
                functions: [
                    GpioOutput,
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator. Switches LED2 through a transistor (LEDs powered by the PMIC, dark if \'Power to LEDs\' is off). Also TRACEDATA[0] / SWO: on v1.0.0 boards the debugger\'s SWO reaches it only with \'SWO Control\' on in Board Configurator; on v0.9.x boards it does through SB24, closed by default (cut it to disconnect).",
            ),
            PinDef(
                number: 19,
                name: "P1.14 (LED3, AIN7, active HIGH)",
                reserved: false,
                functions: [
