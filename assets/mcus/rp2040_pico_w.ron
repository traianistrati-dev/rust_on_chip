                    kind: Output,
                    state: Fixed,
                    limit: None,
                ),
                (
                    id: "clk_ref",
                    kind: Output,
                    state: Fixed,
                    limit: None,
                ),
            ],
            edges: [
                (
                    from: "xosc",
                    to: "pll_sys_fb",
                    input: 0,
                ),
                (
                    from: "pll_sys_fb",
                    to: "pll_sys_pd1",
                    input: 0,
                ),
                (
                    from: "pll_sys_pd1",
                    to: "pll_sys_pd2",
                    input: 0,
                ),
