/// Initialise I2C{N} as a blocking `embedded-hal` 1.0 I2c value.
pub fn init<'d>(
    i2c: Peri<'d, peripherals::I2C{N}>,
    scl: Peri<'d, impl SclPin<peripherals::I2C{N}>>,
    sda: Peri<'d, impl SdaPin<peripherals::I2C{N}>>,
) -> impl embedded_hal::i2c::I2c + 'd {
