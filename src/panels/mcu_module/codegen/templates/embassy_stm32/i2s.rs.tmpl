    ws: Peri<'d, impl WsPin<peripherals::SPI{N}>>,
    ck: Peri<'d, impl CkPin<peripherals::SPI{N}>>,
{MCK_PARAM}    dma: Peri<'d, D>,
    // Only `main.rs` knows WHICH channel this is, so the binding travels with
