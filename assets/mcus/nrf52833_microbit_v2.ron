                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Also LED column 3: the pad joins P0.31 through R11 (105R), which sits in series with your signal, and the pad itself carries the cathodes of the column\'s five LEDs. Stop the display and keep ROW1-5 LOW: a row left HIGH lights its LED whenever this pad goes LOW. Nordic rates this pin low-frequency I/O only (up to 10 kHz).",
            ),
            PinDef(
                number: 3,
                name: "P0.28 (pad 4, COL1)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 0,
                        channel: 4,
                    ),
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
