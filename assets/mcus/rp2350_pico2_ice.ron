McuDefinition(
    id: "rp2350_pico2_ice",
    display_name: "tinyVision pico2-ice (RP2350B + iCE40UP5K)",
    family: "rp235x",
    package: "2x 2x20 headers",
    board_chip: Some("RP2350B"),
    max_mhz: Some(150),
    dma: None,
    cpu: "ARM Cortex-M33 (dual)",
    toolchain: RustEmbedded,
    project: ProjectDef(
        pkg_name: "rp2350_pico2_ice",
        target: "thumbv8m.main-none-eabihf",
        flash_origin: "0x10000000",
        flash_size: "4096K",
        ram_origin: "0x20000000",
        ram_size: "520K",
        hal_dep: "rp235x-hal = { version = \"0.4\", features = [\"rt\", \"critical-section-impl\"] }",
        hal_dep_async: Some("embassy-rp = { version = \"0.10\", features = [\"rp235xb\", \"critical-section-impl\", \"time-driver\"] }"),
        probe_chip: "RP235x",
        memory_comment: "tinyVision pico2-ice (RP2350B)  -  4 MiB Flash / 520 KiB RAM",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 81,
                name: "GP0 (LED G, active LOW)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                ],
                note: "Wired only to RGB LED D2\'s green cathode through 1k (R18): no header or connector reaches GP0, and the FPGA\'s LED is a separate one (D4). D2 is common anode, fed from 3V3 through bridged solder jumper SJ1 on the back; cutting SJ1 darkens all three colours (GP0, GP1, GP9) at once. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 82,
                name: "GP1 (LED R, active LOW)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                ],
                note: "Wired only to RGB LED D2\'s red cathode through 1k (R17): no header or connector reaches GP1, and the FPGA\'s LED is a separate one (D4). D2 is common anode, fed from 3V3 through bridged solder jumper SJ1 on the back; cutting SJ1 darkens all three colours (GP0, GP1, GP9) at once. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 83,
                name: "GP9 (LED B, active LOW)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 4,
                        channel: 2,
                    ),
                ],
                note: "Wired only to RGB LED D2\'s blue cathode through 1k (R19): no header or connector reaches GP9, and the FPGA\'s LED is a separate one (D4). D2 is common anode, fed from 3V3 through bridged solder jumper SJ1 on the back; cutting SJ1 darkens all three colours (GP0, GP1, GP9) at once. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 84,
                name: "PSRAM_CS (GP8)",
                reserved: true,
                functions: [],
            ),
        ],
        bottom: [
            PinDef(
                number: 85,
                name: "GP10 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(1),
                    UsartCts(1),
                    I2cSda(1),
                    TimerPwm(
                        timer: 5,
                        channel: 1,
                    ),
                ],
                note: "Only on the 22-pin 0.5 mm FPC connector J6, pin 14. Unlike GP12..GP19 beside it, not an HSTX pin. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 86,
                name: "GP11 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMosi(1),
                    UsartRts(1),
                    I2cScl(1),
                    TimerPwm(
                        timer: 5,
                        channel: 2,
                    ),
                ],
                note: "Only on the 22-pin 0.5 mm FPC connector J6, pin 15. Unlike GP12..GP19 beside it, not an HSTX pin. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 87,
                name: "GP12 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(1),
                    UsartTx(0),
                    I2cSda(0),
                    TimerPwm(
                        timer: 6,
                        channel: 1,
                    ),
                ],
                note: "Only on FPC connector J6, pin 2, paired with GP13 on pin 3; the current Rev2 design names GP12 Lane0_N and GP13 Lane0_P. GP12..GP19, the RP2350\'s HSTX pins, reach J6 as three data lanes plus a clock pair on GP16/GP17. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 88,
                name: "GP13 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiNss(1),
                    UsartRx(0),
                    I2cScl(0),
                    TimerPwm(
                        timer: 6,
                        channel: 2,
                    ),
                ],
                note: "Only on FPC connector J6, pin 3, paired with GP12 on pin 2; the current Rev2 design names GP13 Lane0_P and GP12 Lane0_N. GP12..GP19, the RP2350\'s HSTX pins, reach J6 as three data lanes plus a clock pair on GP16/GP17. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 89,
                name: "GP14 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(1),
                    UsartCts(0),
                    I2cSda(1),
                    TimerPwm(
                        timer: 7,
                        channel: 1,
                    ),
                ],
                note: "Only on FPC connector J6, pin 5: HSTX pair Lane1_N, with GP15 as Lane1_P. J6 carries GP12..GP19, the RP2350\'s HSTX pins, as three data lanes plus a clock pair on GP16/GP17; HSTX\'s per-pin BITx registers choose which pin drives the clock, so firmware must follow this naming. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 90,
                name: "GP15 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMosi(1),
                    UsartRts(0),
                    I2cScl(1),
                    TimerPwm(
                        timer: 7,
                        channel: 2,
                    ),
                ],
                note: "Only on FPC connector J6, pin 6: HSTX pair Lane1_P, with GP14 as Lane1_N. J6 carries GP12..GP19, the RP2350\'s HSTX pins, as three data lanes plus a clock pair on GP16/GP17; HSTX\'s per-pin BITx registers choose which pin drives the clock, so firmware must follow this naming. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 91,
                name: "GP16 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(0),
                    UsartTx(0),
                    I2cSda(0),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                ],
                note: "Only on FPC connector J6, pin 8: HSTX clock pair Clock_N, with GP17 as Clock_P. J6 carries GP12..GP19, the RP2350\'s HSTX pins, as three data lanes plus this clock pair; HSTX\'s per-pin BITx registers choose which pin drives the clock, so set the CLK bit for GP16/GP17 to match. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 92,
                name: "GP17 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiNss(0),
                    UsartRx(0),
                    I2cScl(0),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                ],
                note: "Only on FPC connector J6, pin 9: HSTX clock pair Clock_P, with GP16 as Clock_N. J6 carries GP12..GP19, the RP2350\'s HSTX pins, as three data lanes plus this clock pair; HSTX\'s per-pin BITx registers choose which pin drives the clock, so set the CLK bit for GP16/GP17 to match. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 93,
                name: "GP18 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(0),
                    UsartCts(0),
                    I2cSda(1),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                ],
                note: "Only on FPC connector J6, pin 11: HSTX pair Lane2_N, with GP19 as Lane2_P. J6 carries GP12..GP19, the RP2350\'s HSTX pins, as three data lanes plus a clock pair on GP16/GP17; HSTX\'s per-pin BITx registers choose which pin drives the clock, so firmware must follow this naming. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 94,
                name: "GP19 (FFC)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMosi(0),
                    UsartRts(0),
                    I2cScl(1),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                ],
                note: "Only on FPC connector J6, pin 12: HSTX pair Lane2_P, with GP18 as Lane2_N. J6 carries GP12..GP19, the RP2350\'s HSTX pins, as three data lanes plus a clock pair on GP16/GP17; HSTX\'s per-pin BITx registers choose which pin drives the clock, so firmware must follow this naming. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
        ],
        left: [
            PinDef(
                number: 1,
                name: "ICE12 (flash IO2)",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 2,
                name: "ICE_CRESET (GP31)",
                reserved: false,
                functions: [
                    GpioOutput,
                ],
                note: "RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 3,
                name: "ICE13 (flash IO3)",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 4,
                name: "GND",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 5,
                name: "3V3_FPGA",
                reserved: true,
                functions: [],
                note: "Tied to 3V3 by bridged jumper SJ6; cut it to turn the FPGA off or feed this rail from outside, e.g. a load switch the RP2350 controls (schematic FPGA Power Note). While it is off, keep GP4-7 and GP20-30 low or undriven, no pull-up: they reach FPGA banks 0 and 1, fed by this rail, and a high pin back-powers it through the iCE40\'s input clamp diodes.",
            ),
            PinDef(
                number: 6,
                name: "3V3_FPGA",
                reserved: true,
                functions: [],
                note: "Tied to 3V3 by bridged jumper SJ6; cut it to turn the FPGA off or feed this rail from outside, e.g. a load switch the RP2350 controls (schematic FPGA Power Note). While it is off, keep GP4-7 and GP20-30 low or undriven, no pull-up: they reach FPGA banks 0 and 1, fed by this rail, and a high pin back-powers it through the iCE40\'s input clamp diodes.",
            ),
            PinDef(
                number: 7,
                name: "GND",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 8,
                name: "GND",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 9,
                name: "ICE28",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 10,
                name: "ICE31",
                reserved: true,
