pub fn init<PINS: serial::Pins<pac::USART{N}>>(
    usart: pac::USART{N},
    pins: PINS,
    afio: &mut afio::Parts,
    clocks: &Clocks,{TXCH_PARAM}{RXCH_PARAM}
) -> (TxHandle, RxHandle) {
    let (tx, rx) = Serial::new(usart, pins, &mut afio.mapr, get_config(), clocks).split();
