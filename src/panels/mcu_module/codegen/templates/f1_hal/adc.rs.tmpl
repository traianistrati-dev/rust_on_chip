//
// ADC1 in one-shot mode: `init` powers it up, calibrates it and sets the
// sample time; each `read` converts ONE pad and blocks until it is done. The
// read is embedded-hal 0.2's `OneShot`, which stm32f1xx-hal's `prelude::*`
// (main.rs imports it) brings into scope.
use stm32f1xx_hal::{adc, pac, rcc::Clocks};

/// The concrete type [`init`] hands back - a NAMED type, so it can be a struct
/// field or an RTIC `Local` resource.
pub type Handle = adc::Adc<pac::ADC1>;

/// `SAMPLE_TIME` as the HAL's enum; past 7 it is the HAL's own default.
const fn sample_time() -> adc::SampleTime {
    match SAMPLE_TIME {
        0 => adc::SampleTime::T_1,
        1 => adc::SampleTime::T_7,
        2 => adc::SampleTime::T_13,
        4 => adc::SampleTime::T_41,
        5 => adc::SampleTime::T_55,
        6 => adc::SampleTime::T_71,
        7 => adc::SampleTime::T_239,
        _ => adc::SampleTime::T_28,
    }
}

/// Power ADC1 up, calibrate it, and set the sample time.
pub fn init(adc1: pac::ADC1, clocks: &Clocks) -> Handle {
    let mut handle = adc::Adc::adc1(adc1, *clocks);
    handle.set_sample_time(sample_time());
    handle
}

