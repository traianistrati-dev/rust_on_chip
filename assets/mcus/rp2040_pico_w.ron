                name: "GP16",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(0),
                    UsartTx(0),
                    I2cSda(0),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
