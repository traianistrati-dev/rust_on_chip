                ],
                note: "Also LED column 1: the pad joins P0.28 through R45 (105R), which sits in series with your signal, and the pad itself carries the cathodes of the column\'s five LEDs. Stop the display and keep ROW1-5 LOW: a row left HIGH lights its LED whenever this pad goes LOW. Nordic rates this pin low-frequency I/O only (up to 10 kHz).",
            ),
            PinDef(
                number: 4,
                name: "P0.14 (pad 5, BTN_A)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(0),
                    UsartRx(0),
                    UsartCts(0),
                    UsartRts(0),
                    UsartTx(1),
                    UsartRx(1),
