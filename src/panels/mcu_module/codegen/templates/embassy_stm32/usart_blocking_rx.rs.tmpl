/// embassy's blocking `UartRx`, with the `embedded-io` `Read` it has no impl
/// of: its own `blocking_read` fills the whole slice it is given, so a read
/// asks for one byte - more would wait for bytes that may never come.
pub struct SerialRx<'d>(pub UartRx<'d, Blocking>);

impl embedded_io::ErrorType for SerialRx<'_> {
    type Error = embassy_stm32::usart::Error;
}

impl embedded_io::Read for SerialRx<'_> {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize, Self::Error> {
        if buf.is_empty() {
            return Ok(0);
        }
        self.0.blocking_read(&mut buf[..1])?;
        Ok(1)
    }
}

