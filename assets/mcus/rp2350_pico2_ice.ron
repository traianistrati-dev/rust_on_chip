            PinDef(
                number: 13,
                name: "ICE36",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 14,
                name: "ICE38",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 15,
                name: "ICE42",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 16,
                name: "ICE43",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 17,
                name: "ICE37",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 18,
                name: "ICE_CLK (GP21)",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 19,
                name: "GP29 (ICE11)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiNss(1),
                    UsartRx(0),
                    I2cScl(0),
                    TimerPwm(
                        timer: 6,
                        channel: 2,
                    ),
                ],
                note: "Same net as iCE40 pin 11, named DEFAULT_UART_TX / DEFAULT_I2C_SCL in pico2_ice.pcf (this pad\'s UART0 RX / I2C0 SCL). Keep it at 3.3 V logic (FPGA pin absolute max 3.6 V, though the RP2350 pad takes 5 V with IOVDD powered) and never let gateware drive pin 11 while the RP2350 does. Until the FPGA is configured, pin 11 holds a weak pull-up (11-128 uA). RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 20,
                name: "ICE6",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 21,
                name: "ICE10 (SW2)",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 22,
                name: "GP28 (ICE9)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(1),
                    UsartTx(0),
                    I2cSda(0),
                    TimerPwm(
                        timer: 6,
                        channel: 1,
                    ),
                ],
                note: "Same net as iCE40 pin 9, named DEFAULT_UART_RX / DEFAULT_I2C_SDA in pico2_ice.pcf (this pad\'s UART0 TX / I2C0 SDA). Keep it at 3.3 V logic (FPGA pin absolute max 3.6 V, though the RP2350 pad takes 5 V with IOVDD powered) and never let gateware drive pin 9 while the RP2350 does. Until the FPGA is configured, pin 9 holds a weak pull-up (11-128 uA). RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 23,
                name: "VIO_BANK2",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 24,
                name: "VIO_BANK2",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 25,
