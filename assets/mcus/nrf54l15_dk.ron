            ),
            PinDef(
                number: 24,
                name: "P0.00 (VCOM0 TXD)",
                reserved: false,
                functions: [
                    GpioOutput,
                    UsartTx(30),
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator. VCOM0 TXD to the debugger through analog switch U4/U5, tri-stated until a terminal sends DTR.",
            ),
            PinDef(
                number: 25,
                name: "P0.01 (VCOM0 RXD)",
                reserved: false,
                functions: [
                    GpioInput,
                    UsartRx(30),
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator. VCOM0 RXD from the debugger through analog switch U4/U5, tri-stated until a terminal sends DTR.",
            ),
            PinDef(
                number: 26,
                name: "P0.03 (VCOM0 CTS)",
                reserved: false,
                functions: [
                    GpioInput,
                    UsartCts(30),
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator. VCOM0 CTS: tri-stated until a terminal sends DTR; once flow control is detected the debugger drives it until a power-on reset or a new DTR.",
            ),
            PinDef(
                number: 27,
                name: "P0.02 (VCOM0 RTS)",
                reserved: false,
                functions: [
                    GpioOutput,
                    UsartRts(30),
