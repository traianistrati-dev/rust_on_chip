// BBC micro:bit v2 (nRF52833) - a BOARD definition, like the Pico ones.
//
// bottom: the edge connector, left to right from the LED side. Rings 0/1/2,
//         3V and GND are the large pads; the small pads are numbered 3..22,
//         and 17/18 are tied to 3V, 21/22 to GND.
// top:    nets wired to on-board hardware and not brought to the connector.
//
// Pad names lead with the nRF port and pin (`P0.31`) so codegen can read the
// GPIO; the part in parentheses is the board's own name for the net.
//
// Pin map from the microbit-v2 0.16 BSP (`microbit-common/src/v2/gpio.rs`),
// cross-checked against tech.microbit.org (edge connector + schematic pages).
// UART directions follow the BSP, which names them from the nRF's side: the
// schematic names the same two nets from the interface MCU's side.
//
// No 32.768 kHz crystal is fitted: XL1/XL2 (P0.00/P0.01) are wired as the
// speaker and SPI MISO. LFCLK is therefore the internal RC or synthesized
// from HFCLK, and the clock graph offers exactly those two.
//
// SPI uses SPIM2 and I2C uses TWIM0/TWIM1. SPIM0/SPIM1 share their peripheral
// IDs with TWIM0/TWIM1, so offering them here would let two modules claim one
// block. SPIM2 has no hardware chip select; NSS is a GPIO.
//
// Pads 8/9 (P0.10/P0.09) default to NFC on the nRF52833. embassy-nrf exposes
// them only with `nfc-pins-as-gpio`; nrf52833-hal needs UICR NFCPINS written.
//
// Pad 12 is reserved: tech.microbit.org says the accessibility pin should not
// be used for anything else.
McuDefinition(
    id: "nrf52833_microbit_v2",
    display_name: "BBC micro:bit v2",
    family: "nrf52833",
    package: "edge connector",
    board_chip: Some("nRF52833"),
    max_mhz: Some(64),
    sram_kb: Some(128),
    cpu: "ARM Cortex-M4F",
    toolchain: RustEmbedded,
    project: ProjectDef(
        pkg_name: "nrf52833_microbit_v2",
        target: "thumbv7em-none-eabihf",
        flash_origin: "0x00000000",
        flash_size: "512K",
        ram_origin: "0x20000000",
        ram_size: "128K",
        hal_dep: "nrf52833-hal = { version = \"0.19\", default-features = false, features = [\"rt\"] }",
        hal_dep_async: Some("embassy-nrf = { version = \"0.11\", features = [\"nrf52833\", \"time-driver-rtc1\", \"gpiote\", \"nfc-pins-as-gpio\"] }"),
        probe_chip: "nRF52833_xxAA",
        memory_comment: "BBC micro:bit v2 (nRF52833)  -  512 KiB Flash / 128 KiB RAM",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 26,
                name: "P0.21 (ROW1)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Drives the anodes of LED row 1 directly; each LED\'s cathode returns to a column pin (COL1-5) through 105R. HIGH here with a column LOW lights that LED. On no edge pad.",
            ),
            PinDef(
                number: 27,
                name: "P0.22 (ROW2)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Drives the anodes of LED row 2 directly; each LED\'s cathode returns to a column pin (COL1-5) through 105R. HIGH here with a column LOW lights that LED. On no edge pad.",
            ),
            PinDef(
                number: 28,
                name: "P0.15 (ROW3)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Drives the anodes of LED row 3 directly; each LED\'s cathode returns to a column pin (COL1-5) through 105R. HIGH here with a column LOW lights that LED. On no edge pad.",
            ),
            PinDef(
                number: 29,
                name: "P0.24 (ROW4)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Drives the anodes of LED row 4 directly; each LED\'s cathode returns to a column pin (COL1-5) through 105R. HIGH here with a column LOW lights that LED. On no edge pad.",
            ),
            PinDef(
                number: 30,
                name: "P0.19 (ROW5)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Drives the anodes of LED row 5 directly; each LED\'s cathode returns to a column pin (COL1-5) through 105R. HIGH here with a column LOW lights that LED. On no edge pad. Nordic rates this pin low-frequency I/O only (up to 10 kHz), so keep faster signals off it.",
            ),
            PinDef(
                number: 31,
                name: "P0.00 (SPEAKER)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Drives speaker SP1 (MLT-8530) via R55 4k7 and C23 100nF into the gate of MOSFET T2 (R17 100k to GND), so it is AC-coupled: only a changing signal such as PWM sounds it. The interface MCU joins ahead of C23 via R54 0R but normally stays high-impedance. Also XL1, and the board has no 32.768 kHz crystal: run LFCLK from RC or synth, not LFXO.",
            ),
            PinDef(
                number: 32,
                name: "P0.05 (MIC_IN)",
                reserved: false,
                functions: [
                    GpioInput,
                    AdcChannel(
                        adc: 0,
                        channel: 3,
                    ),
                ],
                note: "Output of the analog microphone U4 (Knowles SPU0410LR5H), AC-coupled through C54 1uF and DC-biased by R62 33k / R63 1k. The mic is powered only while MIC_RUN (P0.20) is HIGH.",
            ),
            PinDef(
                number: 33,
                name: "P0.20 (MIC_RUN)",
                reserved: false,
                functions: [
                    GpioOutput,
                ],
                note: "The microphone\'s power supply: driven HIGH, it feeds U4 through R28 105R and the red mic LED D70 through R58 68R, so D70 lights whenever the mic is on. The schematic asks for high drive - e.g. embassy-nrf OutputDrive::Standard0HighDrive1; the microbit crate uses Disconnect0HighDrive1.",
            ),
            PinDef(
                number: 34,
                name: "P1.04 (LOGO touch)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "The gold logo on the front, with a 10M pull-up (R53, through R47 0R) to the 3V rail: as a plain input it reads HIGH, and LOW only while a finger bridges it to GND. The micro:bit runtime (CODAL) senses it capacitively instead. Nordic rates this pin low-frequency I/O only (up to 10 kHz).",
            ),
            PinDef(
                number: 35,
                name: "P0.08 (INT_SCL)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    I2cScl(0),
                    I2cScl(1),
                ],
                note: "Internal I2C clock, on no edge pad, with a strong 1k pull-up (R51). On the bus: LSM303AGR accelerometer 0x19 and magnetometer 0x1E (an FXOS8700CQ at 0x1F on boards fitted with it) and the interface MCU at 0x70 (config) and 0x72 (storage), which may clock-stretch. Test point TP20.",
            ),
            PinDef(
                number: 36,
                name: "P0.16 (INT_SDA)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    I2cSda(0),
                    I2cSda(1),
                ],
                note: "Internal I2C data, on no edge pad, with a strong 1k pull-up (R52). Same bus as INT_SCL (P0.08): motion sensor 0x19/0x1E (or 0x1F) and the interface MCU at 0x70/0x72 (0x71 reserved). Test point TP21.",
            ),
            PinDef(
                number: 37,
                name: "P0.25 (SENSOR_INT)",
                reserved: false,
                functions: [
                    GpioInput,
                ],
                note: "Combined open-drain, active-LOW interrupt of the motion sensor and the interface MCU. The board fits no pull-up (only C2 24 pF to GND): enable the nRF\'s internal pull-up, also while sleeping. Any of them can pull it, so query each over the internal I2C. Nordic rates this pin low-frequency I/O only (up to 10 kHz).",
            ),
            PinDef(
                number: 38,
                name: "P0.06 (UART_TX)",
                reserved: false,
                functions: [
                    GpioOutput,
                    UsartTx(0),
                    UsartTx(1),
                ],
                note: "nRF52833 TX to the interface MCU, which bridges it to the micro:bit\'s USB serial port. On no edge pad. The schematic names the net UART_INT_RX, from the interface MCU\'s side; its design note saying the data flows from the interface MCU to the nRF52833 has the direction backwards.",
            ),
            PinDef(
                number: 39,
                name: "P1.08 (UART_RX)",
                reserved: false,
                functions: [
                    GpioInput,
                    UsartRx(0),
                    UsartRx(1),
                ],
                note: "nRF52833 RX from the interface MCU\'s USB serial bridge. On no edge pad. The schematic names the net UART_INT_TX, from the interface MCU\'s side; its design note saying the data flows from the nRF52833 to the interface MCU has the direction backwards.",
            ),
        ],
        bottom: [
            PinDef(
                number: 1,
                name: "P0.02 (ring 0)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 0,
                        channel: 0,
