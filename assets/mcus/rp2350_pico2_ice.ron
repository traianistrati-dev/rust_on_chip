                number: 33,
                name: "ICE3",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 34,
                name: "ICE4",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 35,
                name: "GP2 (SDA)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(0),
                    UsartCts(0),
                    I2cSda(1),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                ],
                note: "10k pull-up to 3V3 on the board (R13). The same net goes to FPC connector J6 pin 21, so a device on the flex cable shares this I2C bus. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 36,
                name: "RUN",
                reserved: true,
                functions: [],
                note: "10k pull-up (R16). The board has no reset button, so this pad is where a reset switch goes.",
            ),
            PinDef(
                number: 37,
                name: "GP3 (SCL)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMosi(0),
                    UsartRts(0),
                    I2cScl(1),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                ],
                note: "10k pull-up to 3V3 on the board (R23). The same net goes to FPC connector J6 pin 20, so a device on the flex cable shares this I2C bus. RP2350 erratum E9, only on a chip marked A2 (A3 and A4 fix it): an input-enabled pad left between VIL and VIH sources about 120 uA and sticks near 2.2 V, which the internal pull-down cannot overcome. Use an external pull-down of 8.2k or less, or the pull-up, or enable the pad\'s input only while reading it.",
            ),
            PinDef(
                number: 38,
                name: "BOOTSEL",
                reserved: true,
                functions: [],
                note: "Net ~USB_BOOT: button SW1 to GND with a 10k pull-up (R32), joined to the flash chip select QSPI_SS through Schottky D6 and 1k (R2). Hold SW1, or short this pad (the docs\' BT pin) to GND, while powering up to get the RP2350\'s USB drive. GP42 reads the same net through 5.1k.",
            ),
            PinDef(
                number: 39,
                name: "ADC7 (GP47)",
                reserved: true,
                functions: [],
                note: "Sized for one lithium cell (schematic note): about 4 V here gives 3.3 V at GP47. The R29 2.2k / R28 10k divider draws about 0.3 mA from the cell nonstop; while the board\'s 3V3 is off, the cell also feeds that rail through R29 and clamp diode D7. R29 limits the current if, say, 12 V lands here; for higher voltages, add a series resistor.",
            ),
            PinDef(
                number: 40,
                name: "GND",
                reserved: true,
                functions: [],
