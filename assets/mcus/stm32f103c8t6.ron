McuDefinition(
    id: "stm32f103c8t6",
    display_name: "STM32F103C8Tx",
    family: "stm32f1",
    package: "LQFP48",
    max_mhz: Some(72),
    cpu: "ARM Cortex-M3",
    toolchain: RustEmbedded,
    project: ProjectDef(
        pkg_name: "stm32f103c8t6",
        target: "thumbv7m-none-eabi",
        flash_origin: "0x08000000",
        flash_size: "64K",
        ram_origin: "0x20000000",
        ram_size: "20K",
        hal_dep: "stm32f1xx-hal = { version = \"0.10\", features = [\"stm32f103\", \"medium\", \"rt\"] }",
        probe_chip: "STM32F103C8",
        memory_comment: "STM32F103C8T6  —  64 KiB Flash / 20 KiB RAM",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 48,
                name: "VDD",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 47,
                name: "VSS",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 46,
                name: "PB9",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    TimerPwm(
                        timer: 4,
                        channel: 4,
                    ),
                    CanTx,
                    I2cSda(1),
                ],
                note: "CAN here cannot run while USB is in use: the two share one 512-byte SRAM. Whenever I2C1 is clocked - here or on PB6/PB7 - its SMBA signal (which stays on PB5) collides with PB5 as an alternate-function output, so remapped SPI1 MOSI in master mode and TIM3_CH2 output on PB5 do not work (errata ES096 2.3.7, 2.3.8). 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 45,
                name: "PB8",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    TimerPwm(
                        timer: 4,
                        channel: 3,
                    ),
                    CanRx,
                    I2cScl(1),
                ],
                note: "CAN here cannot run while USB is in use: the two share one 512-byte SRAM. Whenever I2C1 is clocked - here or on PB6/PB7 - its SMBA signal (which stays on PB5) collides with PB5 as an alternate-function output, so remapped SPI1 MOSI in master mode and TIM3_CH2 output on PB5 do not work (errata ES096 2.3.7, 2.3.8). 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 44,
                name: "BOOT0",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 43,
                name: "PB7",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    I2cSda(1),
                    TimerPwm(
                        timer: 4,
                        channel: 2,
                    ),
                ],
                note: "If I2C1 runs here: while it is clocked, its SMBA signal conflicts with PB5 as an alternate-function output even when SMBA is unused, so remapped SPI1 MOSI in master mode and TIM3_CH2 output on PB5 do not work (errata ES096 2.3.7, 2.3.8). 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 42,
                name: "PB6",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    I2cScl(1),
                    TimerPwm(
                        timer: 4,
                        channel: 1,
                    ),
                ],
                note: "If I2C1 runs here: while it is clocked, its SMBA signal conflicts with PB5 as an alternate-function output even when SMBA is unused, so remapped SPI1 MOSI in master mode and TIM3_CH2 output on PB5 do not work (errata ES096 2.3.7, 2.3.8). 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 41,
                name: "PB5",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMosi(1),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                ],
                note: "Not 5 V tolerant, unlike PB4 and PB6 beside it. While I2C1 is clocked (on PB6/PB7 or PB8/PB9), its SMBA signal conflicts with PB5 as an alternate-function output even when SMBA is unused: remapped SPI1 MOSI in master mode and TIM3_CH2 output do not work here next to I2C1 (errata ES096 2.3.7, 2.3.8).",
            ),
            PinDef(
                number: 40,
                name: "PB4",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(1),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                ],
                note: "NJTRST of the JTAG port from reset, internal pull-up, and no GPIO until it is released (SWJ_CFG = 001 frees only this pad and keeps JTAG). When this pad is used the generated code goes further (afio.mapr.disable_jtag / SwjCfg::SwdOnly, SWJ_CFG = 010): SWD on PA13/PA14 keeps working, JTAG does not. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 39,
                name: "PB3",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(1),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                ],
                note: "JTDO of the JTAG port from reset, and no GPIO until JTAG is switched off. When this pad is used the generated code does that (afio.mapr.disable_jtag / SwjCfg::SwdOnly, SWJ_CFG = 010): SWD on PA13/PA14 keeps working, JTAG does not. A debugger that turns on SWO trace keeps it as TRACESWO. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 38,
                name: "PA15",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiNss(1),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                ],
                note: "JTDI of the JTAG port from reset, internal pull-up, and no GPIO until JTAG is switched off. When this pad is used the generated code does that (afio.mapr.disable_jtag / SwjCfg::SwdOnly, SWJ_CFG = 010): SWD on PA13/PA14 keeps working, JTAG does not. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 37,
                name: "PA14",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SwdClk,
                ],
                note: "SWCLK/JTCK of the debug port from reset, internal pull-down; GPIO settings do nothing while SWD is on. Freeing it takes AFIO_MAPR.SWJ_CFG = 100 (embassy SwjCfg::Disabled; no stm32f1xx-hal 0.10 call); a normal attach then fails, so connect under reset. A Blue Pill\'s 4-pin SWD header has no NRST: hold its RESET button while the probe attaches. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
        ],
        bottom: [
            PinDef(
                number: 13,
                name: "PA3",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 3,
                    ),
                    UsartRx(2),
                    TimerPwm(
                        timer: 2,
                        channel: 4,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 14,
                name: "PA4",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 4,
                    ),
                    SpiNss(1),
                    UsartCk(2),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 15,
                name: "PA5",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 5,
                    ),
                    SpiSck(1),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 16,
                name: "PA6",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 6,
                    ),
                    SpiMiso(1),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 17,
                name: "PA7",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 7,
                    ),
                    SpiMosi(1),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 18,
                name: "PB0",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 8,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 19,
                name: "PB1",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 9,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 4,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 20,
                name: "PB2",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "BOOT1, latched with BOOT0 on the 4th SYSCLK edge after reset and again on leaving Standby: with BOOT0 high, LOW here starts the ROM bootloader and HIGH boots from SRAM. A normal GPIO afterwards. On a Blue Pill board the BOOT1 jumper ties it to 3V3 or GND through R4 (100k). 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 21,
                name: "PB10",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    I2cScl(2),
                    UsartTx(3),
                ],
                note: "5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 22,
                name: "PB11",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    I2cSda(2),
                    UsartRx(3),
                ],
                note: "5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 23,
                name: "VSS",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 24,
                name: "VDD",
                reserved: true,
                functions: [],
            ),
        ],
        left: [
            PinDef(
                number: 1,
                name: "VBAT",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 2,
                name: "PC13",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "Not 5 V tolerant. Fed through the backup-domain switch, which sinks only 3 mA: as an output use the 2 MHz speed with at most 30 pF (stm32f1xx-hal starts at 50 MHz - set_speed with IOPinSpeed::Mhz2) and never source current from it. On a Blue Pill board its LED D2 hangs here through R5 (510R) from 3V3, so LOW lights it.",
            ),
            PinDef(
                number: 3,
                name: "PC14",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "Not 5 V tolerant. The LSE crystal input OSC32_IN: GPIO only while the LSE is off, which takes priority. Fed through the backup-domain switch (3 mA sink): as an output use the 2 MHz speed with at most 30 pF (stm32f1xx-hal starts at 50 MHz) and never source current. On a Blue Pill board the 32.768 kHz crystal Y3 is wired here.",
            ),
            PinDef(
                number: 4,
                name: "PC15",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "Not 5 V tolerant. The LSE crystal output OSC32_OUT: GPIO only while the LSE is off, which takes priority. Fed through the backup-domain switch (3 mA sink): as an output use the 2 MHz speed with at most 30 pF (stm32f1xx-hal starts at 50 MHz) and never source current. On a Blue Pill board the 32.768 kHz crystal Y3 is wired here.",
            ),
            PinDef(
                number: 5,
                name: "PD0",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "OSC_IN after reset: the HSE crystal pin, which the default clock here (8 MHz HSE, PLL x9) uses. As GPIO it needs the clock on HSI plus AFIO_MAPR.PD01_REMAP set by hand, outputs only at the 50 MHz setting, and has no EXTI interrupt on this package. On a Blue Pill board the 8 MHz crystal sits here.",
            ),
            PinDef(
                number: 6,
                name: "PD1",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                ],
                note: "OSC_OUT after reset: the HSE crystal pin, which the default clock here (8 MHz HSE, PLL x9) uses. As GPIO it needs the clock on HSI plus AFIO_MAPR.PD01_REMAP set by hand, outputs only at the 50 MHz setting, and has no EXTI interrupt on this package. On a Blue Pill board the 8 MHz crystal sits here.",
            ),
            PinDef(
                number: 7,
                name: "NRST",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 8,
                name: "VSSA",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 9,
                name: "VDDA",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 10,
                name: "PA0",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 0,
                    ),
                    UsartCts(2),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15. Also the WKUP pin: with PWR_CSR.EWUP set it is forced to input pull-down and a rising edge wakes the chip from Standby.",
            ),
            PinDef(
                number: 11,
                name: "PA1",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 1,
                    ),
                    UsartRts(2),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
            PinDef(
                number: 12,
                name: "PA2",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 1,
                        channel: 2,
                    ),
                    UsartTx(2),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                ],
                note: "Not 5 V tolerant: keep inputs within VDD + 0.3 V. The 5 V tolerant pads are PA8-PA15, PB2-PB4 and PB6-PB15.",
            ),
        ],
        right: [
            PinDef(
                number: 36,
                name: "VDD",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 35,
                name: "VSS",
                reserved: true,
                functions: [],
            ),
            PinDef(
                number: 34,
                name: "PA13",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SwdIo,
                ],
                note: "SWDIO/JTMS of the debug port from reset, internal pull-up; GPIO settings do nothing while SWD is on. Freeing it takes AFIO_MAPR.SWJ_CFG = 100 (embassy SwjCfg::Disabled; no stm32f1xx-hal 0.10 call); a normal attach then fails, so connect under reset. A Blue Pill\'s 4-pin SWD header has no NRST: hold its RESET button while the probe attaches. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 33,
                name: "PA12",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsbDp,
                    CanTx,
                    UsartRts(1),
                ],
                note: "USB D+, which must be pulled up with an external 1.5 kohm resistor to 3.0-3.6 V. USB and CAN share one 512-byte SRAM, so they cannot run at the same time. On a Blue Pill board that pull-up is R10, 4.7k in the maker\'s schematic (10k on some boards), hard-wired to this pad, so it pulls PA12 up even when used as GPIO. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 32,
                name: "PA11",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsbDm,
                    CanRx,
                    UsartCts(1),
                    TimerPwm(
                        timer: 1,
                        channel: 4,
                    ),
                ],
                note: "USB D-. USB and CAN share one 512-byte SRAM, so they cannot run at the same time - whether CAN sits on PA11/PA12 or on PB8/PB9. On a Blue Pill board R9 (20R) wires PA11 to the micro-USB D- pin, so a USB host on that cable adds its 15 kohm pull-down, stronger than the 30-50 kohm internal pull-up: an input relying on that pull-up cannot read high. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 31,
                name: "PA10",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartRx(1),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                ],
                note: "The ROM bootloader (BOOT0 high, BOOT1/PB2 low) talks on USART1: RX here, TX on PA9, 8 data bits, even parity, baud rate auto-detected - the port for flashing over serial without a probe. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 30,
                name: "PA9",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    UsartTx(1),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                ],
                note: "The ROM bootloader (BOOT0 high, BOOT1/PB2 low) uses USART1: TX here, RX on PA10, 8 data bits, even parity, auto-detected baud. Erratum ES096 2.3.10: with TIM1 clocked and its CH2 in PWM mode without output, USART1 TX here sends garbage. embassy\'s SimplePwm (Async runtime) sets all four TIM1 channels to PWM mode; ST\'s remap fix needs a 100-pin package. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 29,
                name: "PA8",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    Mco,
                    UsartCk(1),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                ],
                note: "TIM1 PWM here on the Async runtime also puts TIM1 CH2 in PWM mode with no output (embassy\'s SimplePwm sets all four channels), and erratum ES096 2.3.10 says USART1 TX on PA9 then sends garbage. stm32f1xx-hal (the other runtimes) sets PWM mode only on the wired channels. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 28,
                name: "PB15",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMosi(2),
                ],
                note: "5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 27,
                name: "PB14",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiMiso(2),
                    UsartRts(3),
                ],
                note: "5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 26,
                name: "PB13",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiSck(2),
                    UsartCts(3),
                ],
                note: "5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
            PinDef(
                number: 25,
                name: "PB12",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    SpiNss(2),
                    UsartCk(3),
                ],
                note: "Also I2C2_SMBA (SMBus alert) - not I2C2\'s SCL, which is PB10. Erratum ES096 2.3.6: while I2C2 is clocked, PB12 as an alternate-function output is held high, so with I2C2 in use SPI2 needs software NSS and USART3 must not run synchronous. 5 V tolerant pad: above VDD + 0.3 V it needs its internal pull-up/pull-down off. It takes up to 5.5 V while VDD is above 2 V; its absolute maximum is VDD + 4.0 V, so 4.0 V on an unpowered chip.",
            ),
        ],
    ),
    clock: Stm32f1(Stm32f1Clock(
        hse_hz: 8000000,
        hse_enabled: true,
