            ),
            PinDef(
                number: 24,
                name: "VDD_SPI",
                reserved: true,
                functions: [],
                note: "Supply OUTPUT for the flash/PSRAM: VDDPST2 through RSPI (typ. 3 ohm), so it sits a little below VDDPST2. Put 1 uF close to it and keep VDDPST2 at 3.0 V or more. On ESP32-C61HR2/HR8 the in-package PSRAM must be powered from it, so it can never be GPIO18; on ESP32-C61HF4 it is not connected (NC).",
            ),
