pub const DATA_BITS: u8 = {DATA}; // 8, or 9 with PARITY 'N' - parity not counted (stm32f1xx-hal's word counts it)
pub const PARITY: char = '{PARITY}'; // 'N' None, 'O' Odd, 'E' Even
pub const STOP_BITS: u8 = {STOP}; // 1, 2
