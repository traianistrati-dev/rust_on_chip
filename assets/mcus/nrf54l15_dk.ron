                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator.",
            ),
            PinDef(
                number: 21,
                name: "P1.09 (BUTTON1, active LOW)",
                reserved: false,
                functions: [
                    GpioInput,
                ],
                note: "Logic level is 1.8 V by default (the nPM1300 PMIC\'s VOUT1); set 1.8-3.3 V with \'VDD (nPM VOUT1)\' in nRF Connect for Desktop\'s Board Configurator.",
            ),
