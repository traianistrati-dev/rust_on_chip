                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 3,
                    ),
                ],
                note: "10M pull-up (R9) to the 3V rail for touch sensing: left open it reads HIGH, and a finger bridging it to the GND ring pulls it LOW. For an input that idles LOW, enable the internal pull-down (11-16k), as the micro:bit runtime does by default. Nordic rates this pin low-frequency I/O only (up to 10 kHz).",
            ),
            PinDef(
                number: 2,
                name: "P0.31 (pad 3, COL3)",
                reserved: false,
                functions: [
                    GpioInput,
                    GpioOutput,
                    AdcChannel(
                        adc: 0,
                        channel: 7,
